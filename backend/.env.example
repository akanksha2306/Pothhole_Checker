# ---------------------------------------------------------------------------
# PotholeWatch backend — copy to .env and fill in real values.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database — Neon Postgres connection string (pooled endpoint for the app).
DATABASE_URL=postgresql://user:password@ep-host-region.aws.neon.tech/potholewatch?sslmode=require

# Auth — HS256 session JWT + Google OAuth (sign-in only).
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma-separated emails that get role=ADMIN on login. Empty means no admins.
ADMIN_EMAILS=

# Cloudflare R2 (S3-compatible) — presigned photo uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Clustering
# City prefix for pothole human codes (BLR-00001).
CITY_CODE=BLR
# Nearby-match radius in metres (a new report within this distance is the same pothole).
NEARBY_RADIUS_M=20

# Repair crew allowlist (comma-separated) + evidence GPS radius in metres.
REPAIRER_EMAILS=
REPAIR_GPS_RADIUS_M=25

# Area awareness: radius (m) shown as "potholes within X", and max items returned.
AREA_RADIUS_M=2000
AREA_LIST_LIMIT=10
